{
	"compilerOptions": {
		"paths": {
			"store/*": ["./src/store/*"],
			"components/*": ["./src/components/*"],
			"containers/*": ["./src/containers/*"],
			"pages/*": ["./src/pages/*"],
			"utils/*": ["./src/utils/*"],
			"types/*": ["./src/types/*"],
			"src/*": ["./src/*"],
			"package": ["./package.json"],
			"storybook-fixtures/*": ["./.storybook/fixtures/*"]
		},
		"types": ["chrome", "node", "jest", "firefox-webext-browser"],
		"jsx": "react-jsx",
		"module": "esnext",
		"isolatedModules": true,
		"esModuleInterop": true,
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"preserveConstEnums": true,
		"removeComments": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "es2022",
		"rootDir": ".",
		"outDir": "dist",
		"forceConsistentCasingInFileNames": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"plugins": [
			{
				"name": "typescript-plugin-css-modules"
			}
		]
	},
	"include": ["./**/*"],
	"exclude": ["./node_modules", "./dist", "./.idea", "./packages", "./storybook-static"]
}
