	"homepage": "https://jared-web-extension.netlify.app/",
	"scripts": {
		"dev": "webextension-toolbox dev chrome --config webextension-toolbox.config.js",
		"build": "webextension-toolbox build chrome --config webextension-toolbox.config.js",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:ci": "jest --ci --coverage",
		"test:playwright": "playwright test",
		"test:playwright:ci": "playwright test --headed",
		"test:playwright:coverage": "playwright test --coverage",
		"test:playwright:ui": "playwright test --headed --ui",
		"redux-devtools": "redux-devtools --hostname=localhost --port=1024 --open",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"storybook": "storybook dev -p 6006 --debug-webpack",
		"build-storybook": "storybook build",
		"test-storybook": "test-storybook",
		"prepare": "husky"
	},
